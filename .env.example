# Limit threads during tests to avoid native crashes (optional)
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TQDM_DISABLE=1

# PYTHONPATH for tests
PYTHONPATH=.
ENV=development
DEBUG=True
APP_NAME="Living Museum API"
CORS_ORIGINS=["http://localhost:5173","tauri://localhost"]
# MEDIA_DIR=/path/to/photos
# SANDBOX_STRICT=true
# SIGNED_URL_ENABLED=false
# SIGNED_URL_SECRET=changeme
# SIGNED_URL_TTL_SECONDS=300
# IMAGE_TOKEN_ISSUER_KEY=changeme
# ACCESS_LOG_SALT=changeme
# ACCESS_LOG_MASKING=true
# JWT_AUTH_ENABLED=false
# JWT_SECRET=changeme
# JWT_ALGO=HS256
# JWT_ISSUER=your-issuer
# ACCESS_LOG_UNMASK_ENABLED=false
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_REQS_PER_MIN=600
# PHOTO_METADATA_DB_PATH=/path/to/photo_metadata.db
